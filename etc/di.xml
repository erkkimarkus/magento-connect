<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Dedicated log channel: var/log/smaily_connect.log -->
    <virtualType name="Smaily\Connect\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/smaily_connect.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Smaily\Connect\Logger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">smaily_connect</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Smaily\Connect\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Smaily\Connect\Model\Logger\Logger">
        <arguments>
            <argument name="logger" xsi:type="object">Smaily\Connect\Logger</argument>
        </arguments>
    </type>

    <!-- Marketing event queue handlers, keyed by event type
         (see Cron\FlushEventQueue). -->
    <type name="Smaily\Connect\Model\Queue\HandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="contact.sync" xsi:type="object">Smaily\Connect\Model\Queue\Handler\ContactSyncHandler</item>
                <item name="automation.trigger" xsi:type="object">Smaily\Connect\Model\Queue\Handler\AutomationHandler</item>
            </argument>
        </arguments>
    </type>

    <!-- Newsletter email suppression (Smaily automations own opt-in emails). -->
    <type name="Magento\Newsletter\Model\Subscriber">
        <plugin name="smaily_connect_suppress_newsletter_emails" type="Smaily\Connect\Plugin\SuppressNewsletterEmails"/>
    </type>
</config>
