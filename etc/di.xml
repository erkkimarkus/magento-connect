<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Smaily\Connect\Model\Engine\SleeperInterface" type="Smaily\Connect\Model\Engine\Sleeper"/>

    <!-- Dedicated log channel: var/log/smaily_connect.log -->
    <virtualType name="Smaily\Connect\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/smaily_connect.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Smaily\Connect\Logger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">smaily_connect</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Smaily\Connect\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Smaily\Connect\Model\Logger\Logger">
        <arguments>
            <argument name="logger" xsi:type="object">Smaily\Connect\Logger</argument>
        </arguments>
    </type>

    <!-- Marketing event queue handlers, keyed by event type
         (see Cron\FlushEventQueue). -->
    <type name="Smaily\Connect\Model\Queue\HandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="contact.sync" xsi:type="object">Smaily\Connect\Model\Queue\Handler\ContactSyncHandler</item>
                <item name="automation.trigger" xsi:type="object">Smaily\Connect\Model\Queue\Handler\AutomationHandler</item>
                <item name="engine.identity_merge" xsi:type="object">Smaily\Connect\Model\Queue\Handler\IdentityMergeHandler</item>
            </argument>
        </arguments>
    </type>

    <!-- Newsletter email suppression (Smaily automations own opt-in emails). -->
    <type name="Magento\Newsletter\Model\Subscriber">
        <plugin name="smaily_connect_suppress_newsletter_emails" type="Smaily\Connect\Plugin\SuppressNewsletterEmails"/>
    </type>

    <!-- MSI stock changes → catalog ingest, one thin plugin per seam.
         Optional dependency: if the Magento_Inventory* modules are absent
         these types do not exist, the plugin is never wired and nothing else
         notices. sortOrder puts us behind MSI's own legacy-stock sync in the
         after-chain. -->
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="smaily_connect_engine_source_items_save"
                type="Smaily\Connect\Plugin\Engine\SourceItemsSave"
                sortOrder="100"/>
    </type>
    <type name="Magento\InventorySourceDeductionApi\Model\SourceDeductionServiceInterface">
        <plugin name="smaily_connect_engine_source_deduction"
                type="Smaily\Connect\Plugin\Engine\SourceDeduction"
                sortOrder="100"/>
    </type>

    <!-- Backfill processors, keyed by "{job_type}:{target}". -->
    <type name="Smaily\Connect\Cron\BackfillTick">
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="contacts:smaily" xsi:type="object">Smaily\Connect\Model\Backfill\ContactsProcessor</item>
                <item name="catalog:engine" xsi:type="object">Smaily\Connect\Model\Backfill\EngineCatalogProcessor</item>
                <item name="customers:engine" xsi:type="object">Smaily\Connect\Model\Backfill\EngineCustomersProcessor</item>
                <item name="orders:engine" xsi:type="object">Smaily\Connect\Model\Backfill\EngineOrdersProcessor</item>
            </argument>
        </arguments>
    </type>

    <!-- CLI commands. -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="smaily_backfill_start" xsi:type="object">Smaily\Connect\Console\Command\BackfillStartCommand</item>
                <item name="smaily_backfill_status" xsi:type="object">Smaily\Connect\Console\Command\BackfillStatusCommand</item>
                <item name="smaily_engine_ping" xsi:type="object">Smaily\Connect\Console\Command\EnginePingCommand</item>
                <item name="smaily_engine_disconnect" xsi:type="object">Smaily\Connect\Console\Command\EngineDisconnectCommand</item>
                <item name="smaily_gdpr" xsi:type="object">Smaily\Connect\Console\Command\GdprCommand</item>
            </argument>
        </arguments>
    </type>
</config>
