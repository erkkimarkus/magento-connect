<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="smaily_connect">
        <job name="smaily_flush_event_queue" instance="Smaily\Connect\Cron\FlushEventQueue" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="smaily_queue_janitor" instance="Smaily\Connect\Cron\QueueJanitor" method="execute">
            <schedule>20 2 * * *</schedule>
        </job>
        <job name="smaily_contact_reconcile" instance="Smaily\Connect\Cron\ContactReconcile" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="smaily_abandoned_cart" instance="Smaily\Connect\Cron\AbandonedCart" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="smaily_backfill_tick" instance="Smaily\Connect\Cron\BackfillTick" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="smaily_flush_ingest_queue" instance="Smaily\Connect\Cron\FlushIngestQueue" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="smaily_health_check" instance="Smaily\Connect\Cron\HealthCheck" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <!-- Nightly catalog reconciler (PRO-1951): off-peak, and after the
             janitor so it never queues into a table that is being pruned. -->
        <job name="smaily_catalog_resync" instance="Smaily\Connect\Cron\CatalogResync" method="execute">
            <schedule>40 3 * * *</schedule>
        </job>
    </group>
</config>
