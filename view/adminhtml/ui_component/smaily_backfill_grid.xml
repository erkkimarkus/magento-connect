<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">smaily_backfill_grid.smaily_backfill_grid_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>smaily_backfill_columns</spinner>
        <deps>
            <dep>smaily_backfill_grid.smaily_backfill_grid_data_source</dep>
        </deps>
    </settings>
    <dataSource name="smaily_backfill_grid_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <!-- The client-side grid data storage keys rows by entity_id
                 unless told otherwise; these tables' primary key is `id`
                 (and the queue tables carry an unrelated entity_id payload
                 column), so without this the grid renders colliding,
                 duplicated rows. -->
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Smaily_Connect::backfill</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="smaily_backfill_grid_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="smaily_backfill_columns">
        <column name="id" sortOrder="10">
            <settings>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="job_type" sortOrder="20">
            <settings>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="target" sortOrder="30">
            <settings>
                <label translate="true">Target</label>
            </settings>
        </column>
        <column name="website_id" sortOrder="40">
            <settings>
                <label translate="true">Website</label>
            </settings>
        </column>
        <column name="status" sortOrder="50">
            <settings>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="processed_count" sortOrder="60">
            <settings>
                <label translate="true">Processed</label>
            </settings>
        </column>
        <column name="total_count" sortOrder="70">
            <settings>
                <label translate="true">Total</label>
            </settings>
        </column>
        <column name="failed_count" sortOrder="80">
            <settings>
                <label translate="true">Failed</label>
            </settings>
        </column>
        <column name="error_message" sortOrder="90">
            <settings>
                <label translate="true">Error</label>
            </settings>
        </column>
        <column name="completed_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="100">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Completed</label>
            </settings>
        </column>
    </columns>
</listing>
