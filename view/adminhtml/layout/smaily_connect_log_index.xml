<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Smaily_Connect::css/smaily-admin.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="smaily.intro.log"
                   template="Smaily_Connect::intro.phtml"
                   before="-">
                <arguments>
                    <argument name="intro_text" xsi:type="string">Every delivery lands here: subscriber syncs and automation triggers to Smaily, plus catalog, customer, order and browse data to Campaign Intelligence — the Source column tells them apart. Failed rows retry automatically with backoff for up to 5 attempts; anything still failed can be selected and retried manually. Sent rows are kept for 30 days, failed rows for 90. If something seems missing in Smaily, this is the first place to look.</argument>
                </arguments>
            </block>
            <block class="Magento\Backend\Block\Template"
                   name="smaily.log.failed.banner"
                   template="Smaily_Connect::log/failed-banner.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\Adminhtml\LogHealth</argument>
                </arguments>
            </block>
            <block class="Magento\Backend\Block\Template"
                   name="smaily.log.verbosity"
                   template="Smaily_Connect::log/verbosity.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\Adminhtml\LogVerbositySettings</argument>
                </arguments>
            </block>
            <uiComponent name="smaily_log_grid"/>
            <block class="Magento\Backend\Block\Template"
                   name="smaily.log.url.filter.applier"
                   template="Smaily_Connect::log/url-filter-applier.phtml">
                <arguments>
                    <argument name="listing_namespace" xsi:type="string">smaily_log_grid</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
