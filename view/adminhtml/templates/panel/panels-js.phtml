 *
 * Shared behavior for the step/tab panels — included by BOTH the setup
 * wizard and the Settings page, so the two surfaces run the same code
 * instead of copies. Defines window.smailyPanelsInit synchronously (no
 * dependencies); the page script passes jQuery in and receives the API:
 *
 *   var panels = window.smailyPanelsInit($);
 *   panels.initAll();               // prefill + wire whatever panels exist
 *   panels.collect.connect();       // per-panel save payloads
 *   panels.saveStep(name, data);    // POST to the shared savestep endpoint
 *
 * Strings are translated server-side: Magento's js-translation.json
 * dictionary is built from .js and .html files only — $t() inside a phtml
 * inline script never gets collected, so it would always render English.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Smaily\Connect\ViewModel\Adminhtml\WizardData $viewModel */
$viewModel = $block->getData('view_model');
// Connection/Subscribers/Automations are website-scoped (RFC_MULTI_WEBSITE.md
// §2): every AJAX call those tabs make carries the currently selected website
// so Model\Adminhtml\WebsiteContext resolves the same target the page was
// rendered with, no further plumbing. Intelligence/backfill stay installation-
// wide in this phase (Phase 4/5), so their URLs are left as-is.
$websiteQuery = ['_query' => ['website' => $viewModel->getSelectedWebsiteId()]];
$urls = [
    'test' => $block->getUrl('smaily_connect/api/testsmaily', $websiteQuery),
    'workflows' => $block->getUrl('smaily_connect/api/workflows', $websiteQuery),
    'saveStep' => $block->getUrl('smaily_connect/api/savestep', $websiteQuery),
    'engineExchange' => $block->getUrl('smaily_connect/api/engineexchange'),
    'enginePing' => $block->getUrl('smaily_connect/api/engineping'),
    'backfill' => $block->getUrl('smaily_connect/api/backfillstate'),
    'logFailed' => $block->getUrl('smaily_connect/log', ['_query' => ['filters' => ['status' => 'failed']]]),
];
?>
<script>
window.smailyPanelsInit = function ($) {
    'use strict';

    var boot = <?= /* @noEscape */ $viewModel->getBootJson() ?>;
    var urls = <?= /* @noEscape */ json_encode(array_map('strval', $urls)) ?>;
    var connected = boot.connected;
    var mlLanguages = (boot.multilingual || {}).languages || [];
    var mlFallbackSaved = (boot.multilingual || {}).fallbackLanguage || '';
    var isMultilingual = mlLanguages.length > 1;
    var mlModeCurrent = isMultilingual ? (boot.connection.multilingualMode || 'single') : 'single';
    var mlModeSaved = mlModeCurrent;
    var mlSwitchConfirmed = false;

    function post(url, data) {
        // Some URLs (Connection/Subscribers/Automations, RFC_MULTI_WEBSITE.md
        // §2) already carry a ?website=<id> query string baked in server-side
        // — append with & instead of a second ? so form_key still parses.
        var separator = url.indexOf('?') === -1 ? '?' : '&';
        return fetch(url + separator + 'form_key=' + encodeURIComponent(window.FORM_KEY), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data || {})
        }).then(function (r) { return r.json(); });
    }

    // Shared AJAX status channel, rendered with the Stage A inline-status
    // vocabulary (CSS-only glyphs). State is inferred so no call site changes:
    // in-progress copy carries an ellipsis (spinner), ok = check, error = error
    // glyph, empty = idle/hidden. The .ok/.err classes are kept for any legacy
    // hook, but the color now comes from the inline-status roles.
    function result(selector, text, ok, link) {
        var $el = $(selector);
        text = text || '';
        var working = text.indexOf('…') !== -1; // ellipsis = still working
        var state = text === '' ? 'idle' : (working ? 'working' : (ok ? 'saved' : 'error'));
        $el.empty()
            .removeClass('ok err is-idle is-working is-saved is-error')
            .addClass('smaily-inline-status')
            .addClass(ok ? 'ok' : 'err')
            .addClass('is-' + state);
        if (text !== '') {
            if (state === 'working') {
                $el.append($('<span></span>').addClass('smaily-inline-status__spinner'));
            } else if (state === 'saved') {
                $el.append($('<span></span>').addClass('smaily-inline-status__check'));
            } else if (state === 'error') {
                $el.append($('<span></span>').addClass('smaily-inline-status__error').text('!'));
            }
            $el.append($('<span></span>').text(text));
        }
        if (link) {
            $el.append(' ').append($('<a></a>').attr('href', link.href).text(link.label));
        }
    }

    function credentials() {
        return {
            subdomain: $('#smaily-w-subdomain').val(),
            username: $('#smaily-w-username').val(),
            password: $('#smaily-w-password').val(),
            // Falls back to the saved credentials of the selected website's
            // own store scope whenever the password field is left blank (see
            // Controller\Adminhtml\Api\Workflows/TestSmaily) — keeps the
            // workflow list / Test Connection scoped to whichever website the
            // Settings selector currently targets.
            store_id: boot.storeId
        };
    }

    function saveStep(name, data) {
        return post(urls.saveStep, {step: name, data: data}).then(function (response) {
            if (!response.saved) {
                var message = (response.errors || []).map(function (e) { return e.message; }).join(' ');
                throw new Error(message || '<?= $escaper->escapeJs(__('Saving failed.')) ?>');
            }
            if (name === 'connect' && data) {
                // The saved multilingual state is the new baseline: switching
                // away again warns again, and saved account blocks may now
                // rely on their stored passwords.
                mlModeCurrent = data.multilingual_mode || mlModeCurrent;
                mlModeSaved = mlModeCurrent;
                mlSwitchConfirmed = false;
                if (data.fallback_language) {
                    mlFallbackSaved = data.fallback_language;
                }
                (data.accounts || []).forEach(function (account) {
                    var $block = $('.smaily-ml-account[data-language=' + account.language + ']');
                    $block.data('saved-subdomain', account.subdomain)
                        .data('saved-username', account.username);
                    if (account.password) {
                        $block.data('has-password', 1);
                        $block.find('.smaily-ml-password').val('');
                    }
                });
            }
        });
    }

    // A saved workflow id absent from the freshly loaded Smaily list gets no
    // option of its own, so it would render blank and post empty. Re-add it as
    // a labelled, selected option so the binding stays visible and survives the
    // save (server-side preserve backs this up) — PRO-1286, mirroring the
    // engine-automations block.
    function keptOption(id) {
        return new Option(
            '<?= $escaper->escapeJs(__('Workflow #%1 (not in your Smaily list — kept)')) ?>'
                .replace('%1', id),
            id
        );
    }

    function fillOptions($select, workflows, current) {
        current = String(current || '');
        var found = false;
        $select.empty().append(new Option('<?= $escaper->escapeJs(__('-- Not Selected --')) ?>', ''));
        (workflows || []).forEach(function (w) {
            $select.append(new Option(w.name + ' (' + w.id + ')', w.id));
            if (String(w.id) === current) {
                found = true;
            }
        });
        if (current !== '' && !found) {
            $select.append(keptOption(current));
        }
        $select.val(current);
    }

    function fillWorkflows(workflows) {
        $('.smaily-w-workflow').each(function () {
            var $select = $(this);
            fillOptions($select, workflows, $select.val() || $select.data('saved') || '');
        });
    }

    function loadWorkflows(resultSelector) {
        loadMappingWorkflows();
        return post(urls.workflows, credentials()).then(function (data) {
            fillWorkflows(data.workflows);
            if (data.error && resultSelector) {
                result(resultSelector, data.error, false);
            }
        });
    }

    // --- Multilingual routing (mode cards + mode A/B sections) --------------
    function currentMlMode() {
        if (!isMultilingual) {
            return 'single';
        }
        return $('input[name=smaily-w-mlmode]:checked').val() || mlModeCurrent;
    }

    function applyMlMode(mode) {
        var modeA = isMultilingual && mode === 'a';
        var mapping = isMultilingual && (mode === 'a' || mode === 'b');
        $('#smaily-w-default-account').toggle(!modeA);
        $('#smaily-w-accounts').toggle(modeA);
        $('#smaily-ml-mapping').toggle(mapping);
        $('#smaily-ml-mapping-off').toggle(isMultilingual && !mapping);
        $('#smaily-ml-mapping .smaily-ml-hint-a').toggle(mode === 'a');
        $('#smaily-ml-mapping .smaily-ml-hint-b').toggle(mode === 'b');
        $('#smaily-ml-modes .smaily-choice').removeClass('is-selected');
        $('input[name=smaily-w-mlmode][value=' + mode + ']').closest('.smaily-choice').addClass('is-selected');
    }

    function mlAccountFields($block) {
        return {
            language: String($block.data('language')),
            subdomain: $block.find('.smaily-ml-subdomain').val(),
            username: $block.find('.smaily-ml-username').val(),
            password: $block.find('.smaily-ml-password').val()
        };
    }

    /**
     * Credentials payload for testing / listing workflows of a per-language
     * account: typed values win; an untouched block with a saved password
     * falls back to the saved store-view credentials (store_id); null when
     * the block cannot be exercised without a password.
     */
    function mlAccountRequestCreds($block) {
        var fields = mlAccountFields($block);
        if (fields.password) {
            return {subdomain: fields.subdomain, username: fields.username, password: fields.password};
        }
        var unchanged = fields.subdomain === String($block.data('saved-subdomain') || '')
            && fields.username === String($block.data('saved-username') || '');
        if (unchanged && $block.data('has-password')) {
            return {store_id: $block.data('store-id')};
        }
        return null;
    }

    function fillMappingSelects($selects, workflows) {
        $selects.each(function () {
            var $select = $(this);
            fillOptions($select, workflows, $select.val() || $select.data('saved') || '');
        });
    }

    /**
     * Re-renders the per-language mapping dropdowns live: mode B lists the
     * default account's workflows everywhere; mode A lists each language
     * account's own workflows in that language's rows.
     */
    function loadMappingWorkflows() {
        var mode = currentMlMode();
        if (!isMultilingual || (mode !== 'a' && mode !== 'b')) {
            return;
        }
        if (mode === 'b') {
            post(urls.workflows, credentials()).then(function (data) {
                fillMappingSelects($('.smaily-ml-workflow'), data.workflows);
            });
            return;
        }
        mlLanguages.forEach(function (language) {
            var $block = $('.smaily-ml-account[data-language=' + language + ']');
            var $selects = $('.smaily-ml-workflow[data-language=' + language + ']');
            var creds = mlAccountRequestCreds($block);
            if (!creds) {
                fillMappingSelects($selects, []);
                return;
            }
            post(urls.workflows, creds).then(function (data) {
                fillMappingSelects($selects, data.workflows || []);
            });
        });
    }

    // --- Backfill progress polling (contacts + engine imports) -------------
    // Terminal outcomes are honest (Shopify-parity copy): "Done, X of Y
    // synced" when everything landed; "N failed — view in the Log" when
    // individual rows failed (queue rows still pending retry are NOT
    // failed); "Stopped before an error" when the job itself aborted;
    // "Cancelled" after an admin cancel. The last outcome + timestamp
    // persist server-side and re-render on every page load.
    var backfillTimers = {};

    function withDate(text, data) {
        return data.finished_at ? text + ' (' + data.finished_at + ')' : text;
    }

    function scheduleNextPoll(jobType, ui) {
        backfillTimers[jobType] = setTimeout(function () {
            pollBackfill(jobType, ui, 'status');
        }, 4000);
    }

    // Drives the Stage A .smaily-progress component: width lives on __fill,
    // the state class picks the color (running = striped accent; done/failed/
    // stopped recolor and stop animating).
    function setProgress(ui, percent, state) {
        var pct = Math.max(0, Math.min(100, parseInt(percent, 10) || 0));
        ui.bar.show()
            .removeClass('is-running is-done is-failed is-stopped')
            .addClass('is-' + state)
            .find('.smaily-progress__fill').css('width', pct + '%');
    }

    function renderBackfill(jobType, data, ui) {
        var text;
        if (data.status === 'pending') {
            // Queued, but the cron tick hasn't picked it up yet — no page has
            // been processed, so a "0 / ?" progress bar would just look stuck.
            // Reassure instead of showing fake progress; Cancel stays available.
            ui.bar.hide();
            ui.cancel.show();
            result(ui.result,
                '<?= $escaper->escapeJs(__('Queued — the import starts on the next scheduled run…')) ?>', true);
            scheduleNextPoll(jobType, ui);
            return;
        }
        if (data.status === 'running') {
            setProgress(ui, data.percent, 'running');
            ui.cancel.show();
            result(ui.result,
                '<?= $escaper->escapeJs(__('Importing… %1 / %2')) ?>'
                    .replace('%1', data.processed).replace('%2', data.total || '?'), true);
            scheduleNextPoll(jobType, ui);
            return;
        }
        ui.cancel.hide();
        if (data.status === 'completed' && !data.failed) {
            setProgress(ui, 100, 'done');
            text = '<?= $escaper->escapeJs(__('Done, %1 of %2 synced.')) ?>'
                .replace('%1', data.processed).replace('%2', data.total || data.processed);
            result(ui.result, withDate(text, data), true);
        } else if (data.status === 'completed') {
            setProgress(ui, data.percent, 'failed');
            text = '<?= $escaper->escapeJs(__('Done, %1 of %2 synced — %3 failed.')) ?>'
                .replace('%1', data.processed)
                .replace('%2', data.total || data.processed + data.failed)
                .replace('%3', data.failed);
            result(ui.result, withDate(text, data), false,
                {label: '<?= $escaper->escapeJs(__('View them in the Log')) ?>', href: urls.logFailed});
        } else if (data.status === 'failed') {
            setProgress(ui, data.percent, 'failed');
            text = '<?= $escaper->escapeJs(__('Stopped before an error — %1 of %2 synced so far. Press the import button to run it again.')) ?>'
                .replace('%1', data.processed).replace('%2', data.total || '?');
            if (data.error) {
                text += ' ' + data.error;
            }
            result(ui.result, withDate(text, data), false);
        } else if (data.status === 'cancelled') {
            setProgress(ui, data.percent, 'stopped');
            text = '<?= $escaper->escapeJs(__('Cancelled — %1 of %2 synced. Starting again begins a fresh import.')) ?>'
                .replace('%1', data.processed).replace('%2', data.total || '?');
            result(ui.result, withDate(text, data), true);
        }
    }

    function pollBackfill(jobType, ui, action) {
        post(urls.backfill, {job_type: jobType, action: action}).then(function (data) {
            renderBackfill(jobType, data, ui);
        });
    }

    function startBackfill(jobType, ui) {
        clearTimeout(backfillTimers[jobType]);
        pollBackfill(jobType, ui, 'start');
    }

    function cancelBackfill(jobType, ui) {
        clearTimeout(backfillTimers[jobType]);
        result(ui.result, '<?= $escaper->escapeJs(__('Cancelling…')) ?>', true);
        pollBackfill(jobType, ui, 'cancel');
    }

    function engineConnected(tenantName, engineVersion) {
        $('#smaily-w-engine-disconnected').hide();
        $('#smaily-w-engine-connected').show();
        $('#smaily-w-engine-status').text(
            '<?= $escaper->escapeJs(__('Connected: %1 (engine %2)')) ?>'
                .replace('%1', tenantName).replace('%2', engineVersion)
        );
    }

    // --- Live reactivity within panels --------------------------------------
    function reactAutomationRow(checkboxSelector, selectSelector) {
        var apply = function () {
            var $cb = $(checkboxSelector);
            var on = $cb.is(':checked');
            $(selectSelector).prop('disabled', !on);
            // Card + run-mode pill follow the enable toggle (store-event cards).
            var $card = $cb.closest('.smaily-store-trigger');
            if ($card.length) {
                $card.toggleClass('is-active', on).toggleClass('is-off', !on);
                $card.find('.smaily-store-pill')
                    .toggleClass('smaily-pill--active', on).toggleClass('smaily-pill--off', !on)
                    .find('.smaily-store-pill__text')
                    .text(on ? '<?= $escaper->escapeJs(__('Active')) ?>' : '<?= $escaper->escapeJs(__('Off')) ?>');
            }
        };
        $(document).on('change', checkboxSelector, apply);
        apply();
    }

    function reactSubscribersEnabled() {
        if (!$('#smaily-w-sync-enabled').length) {
            return;
        }
        var apply = function () {
            var on = $('#smaily-w-sync-enabled').is(':checked');
            $('#smaily-w-subscribers-body').toggleClass('smaily-muted', !on)
                .find('input').prop('disabled', !on);
        };
        $(document).on('change', '#smaily-w-sync-enabled', apply);
        apply();
    }

    // Native `depends`: automation_force_opt_in only applies in legitimate-
    // interest mode (Model\ContactSync\Mode::automationForceOptIn()) — the row
    // is hidden outside it, same as the native config field's dependency.
    function reactSyncMode() {
        var $row = $('#smaily-w-force-opt-in-row');
        if (!$row.length) {
            return;
        }
        var apply = function () {
            $row.toggle($('input[name=smaily-w-mode]:checked').val() === 'legitimate_interest');
        };
        $(document).on('change', 'input[name=smaily-w-mode]', apply);
        apply();
    }

    function reactRssEnabled() {
        if (!$('#smaily-w-rss-enabled').length) {
            return;
        }
        var apply = function () {
            $('#smaily-w-rss-builder-wrap').toggle($('#smaily-w-rss-enabled').is(':checked'));
        };
        $(document).on('change', '#smaily-w-rss-enabled', apply);
        apply();
    }

    // --- Prefill from the saved settings ------------------------------------
    function initAll() {
        // Connection.
        $('#smaily-w-subdomain').val(boot.connection.subdomain);
        $('#smaily-w-username').val(boot.connection.username);
        if (boot.connection.hasPassword) {
            $('#smaily-w-password-note').show();
        }
        if (connected) {
            result('#smaily-w-test-result', '<?= $escaper->escapeJs(__('Connected with the saved credentials.')) ?>', true);
        }
        if ($('#smaily-w-connection-status').length) {
            $('#smaily-w-connection-pill').toggleClass('smaily-pill--active', connected)
                .toggleClass('smaily-pill--off', !connected);
            $('#smaily-w-connection-pill-text').text(connected
                ? '<?= $escaper->escapeJs(__('Connected')) ?>'
                : '<?= $escaper->escapeJs(__('Not connected')) ?>');
            $('#smaily-w-connection-account').text(connected
                ? '<?= $escaper->escapeJs(__('as "%1"')) ?>'.replace('%1', boot.connection.subdomain)
                : '');
        }

        // Subscribers (sync-field checkboxes are server-rendered).
        $('#smaily-w-sync-enabled').prop('checked', boot.subscribers.syncEnabled);
        $('input[name=smaily-w-mode][value=' + boot.subscribers.syncMode + ']').prop('checked', true);
        $('#smaily-w-checkout-optin').prop('checked', boot.subscribers.checkoutOptin);
        $('#smaily-w-suppress').prop('checked', boot.subscribers.suppressOptinEmails);
        $('#smaily-w-include-guests').prop('checked', boot.subscribers.includeGuests);
        $('#smaily-w-force-opt-in').prop('checked', boot.subscribers.forceOptIn);

        // Automations.
        $('#smaily-w-welcome-enabled').prop('checked', boot.automations.welcomeEnabled);
        $('#smaily-w-firstorder-enabled').prop('checked', boot.automations.firstOrderEnabled);
        $('#smaily-w-abandoned-enabled').prop('checked', boot.automations.abandonedEnabled);
        $('#smaily-w-cutoff').val(boot.automations.abandonedCutoff);
        $('#smaily-w-welcome-workflow').data('saved', boot.automations.welcomeWorkflow);
        $('#smaily-w-firstorder-workflow').data('saved', boot.automations.firstOrderWorkflow);
        $('#smaily-w-abandoned-workflow').data('saved', boot.automations.abandonedWorkflow);

        // Intelligence.
        if (boot.intelligence.connected) {
            engineConnected(boot.intelligence.tenantName, boot.intelligence.engineVersion);
            $('#smaily-w-browse').prop('checked', boot.intelligence.browseTracking);
            $('#smaily-w-sync-catalog').prop('checked', boot.intelligence.syncCatalog);
            $('#smaily-w-sync-customers').prop('checked', boot.intelligence.syncCustomers);
            $('#smaily-w-sync-orders').prop('checked', boot.intelligence.syncOrders);
        }

        // RSS (Settings only).
        $('#smaily-w-rss-enabled').prop('checked', boot.rss.enabled);

        // Radio-card highlight (scoped to the lawful-basis cards so it never
        // clears the multilingual mode cards' selection).
        $(document).on('change', 'input[name=smaily-w-mode]', function () {
            $('input[name=smaily-w-mode]').closest('.smaily-choice').removeClass('is-selected');
            $(this).closest('.smaily-choice').addClass('is-selected');
        });
        $('input[name=smaily-w-mode]:checked').trigger('change');

        // Live reactivity: dependent fields follow their controlling toggle.
        reactAutomationRow('#smaily-w-welcome-enabled', '#smaily-w-welcome-workflow');
        reactAutomationRow('#smaily-w-firstorder-enabled', '#smaily-w-firstorder-workflow');
        reactAutomationRow('#smaily-w-abandoned-enabled', '#smaily-w-abandoned-workflow, #smaily-w-cutoff');
        reactSubscribersEnabled();
        reactSyncMode();
        reactRssEnabled();

        // Multilingual mode cards: live re-render of the dependent sections,
        // with a confirm before leaving a SAVED mode that carries
        // per-language configuration (the switch removes mode-A store-view
        // credentials on save and stops using the workflow mappings).
        // Unsaved exploration between the cards never asks.
        applyMlMode(mlModeCurrent);
        $(document).on('change', 'input[name=smaily-w-mlmode]', function () {
            var next = $(this).val();
            var leavingConfigured = (mlModeSaved === 'a' || mlModeSaved === 'b') && next !== mlModeSaved;
            if (leavingConfigured && !mlSwitchConfirmed) {
                var message = '<?= $escaper->escapeJs(__('Switching the multilingual mode changes how contacts and automations are routed. Per-language accounts and workflow mappings that no longer apply stop being used (per-store-view credentials are removed on save). Continue?')) ?>';
                if (!window.confirm(message)) {
                    $('input[name=smaily-w-mlmode][value=' + mlModeCurrent + ']').prop('checked', true);
                    return;
                }
                mlSwitchConfirmed = true;
            }
            mlModeCurrent = next;
            applyMlMode(next);
            loadMappingWorkflows();
        });

        // Per-language account connection tests (mode A).
        $(document).on('click', '.smaily-ml-test', function () {
            var $block = $(this).closest('.smaily-ml-account');
            var $result = $block.find('.smaily-result');
            var creds = mlAccountRequestCreds($block);
            if (!creds) {
                result($result, '<?= $escaper->escapeJs(__('Enter the password for this account first.')) ?>', false);
                return;
            }
            result($result, '<?= $escaper->escapeJs(__('Testing…')) ?>', true);
            post(urls.test, creds).then(function (data) {
                result($result, data.connected
                    ? '<?= $escaper->escapeJs(__('Connected!')) ?>'
                    : (data.error || '<?= $escaper->escapeJs(__('Connection failed.')) ?>'), data.connected);
                if (data.connected) {
                    loadMappingWorkflows();
                }
            });
        });

        // Edited per-language credentials re-render that account's workflow
        // dropdowns without saving (same idiom as the default credentials).
        var mlCredentialTimer = null;
        $(document).on('input', '.smaily-ml-account input', function () {
            clearTimeout(mlCredentialTimer);
            mlCredentialTimer = setTimeout(loadMappingWorkflows, 1200);
        });

        // Connection test.
        $('#smaily-w-test').on('click', function () {
            result('#smaily-w-test-result', '<?= $escaper->escapeJs(__('Testing…')) ?>', true);
            post(urls.test, credentials()).then(function (data) {
                connected = !!data.connected;
                result('#smaily-w-test-result', data.connected
                    ? '<?= $escaper->escapeJs(__('Connected! Continue to the next step.')) ?>'
                    : (data.error || '<?= $escaper->escapeJs(__('Connection failed.')) ?>'), data.connected);
                if (data.connected) {
                    // Changed credentials re-render the dependent workflow
                    // dropdowns without saving anything.
                    loadWorkflows(null);
                }
            });
        });

        // Contacts import (wizard step 2 + Settings > Subscribers).
        if ($('#smaily-w-backfill').length) {
            var contactsUi = {
                bar: $('#smaily-w-backfill-bar'),
                result: '#smaily-w-backfill-result',
                cancel: $('#smaily-w-backfill-cancel')
            };
            $('#smaily-w-backfill').on('click', function () {
                startBackfill('contacts', contactsUi);
            });
            contactsUi.cancel.on('click', function () {
                cancelBackfill('contacts', contactsUi);
            });
            // Persisted last-run outcome (and live progress of a job that
            // is already running) renders without pressing anything.
            pollBackfill('contacts', contactsUi, 'status');
        }

        // Engine imports (Settings only).
        $('.smaily-import-row').each(function () {
            var $row = $(this),
                jobType = $row.data('job-type'),
                ui = {
                    bar: $row.find('.smaily-progress'),
                    result: $row.find('.smaily-result'),
                    cancel: $row.find('.smaily-w-engine-cancel')
                };
            $row.find('.smaily-w-engine-import').on('click', function () {
                startBackfill(jobType, ui);
            });
            ui.cancel.on('click', function () {
                cancelBackfill(jobType, ui);
            });
            pollBackfill(jobType, ui, 'status');
        });

        // Workflow refresh.
        $('#smaily-w-refresh-workflows').on('click', function () {
            loadWorkflows(null);
        });

        // Engine connect.
        $('#smaily-w-engine-connect').on('click', function () {
            result('#smaily-w-engine-result', '<?= $escaper->escapeJs(__('Connecting…')) ?>', true);
            post(urls.engineExchange, {setup_url: $('#smaily-w-setup-url').val()}).then(function (data) {
                if (data.connected) {
                    engineConnected(data.tenantName, data.engineVersion);
                } else {
                    result('#smaily-w-engine-result',
                        data.message || '<?= $escaper->escapeJs(__('Connection failed.')) ?>', false);
                }
            });
        });
    }

    // --- Per-panel save payloads (shared savestep endpoint) -----------------
    var collect = {
        connect: function () {
            var mode = currentMlMode();
            if (isMultilingual && mode === 'a') {
                var accounts = [];
                $('.smaily-ml-account').each(function () {
                    var fields = mlAccountFields($(this));
                    if (!fields.subdomain || !fields.username) {
                        throw new Error(
                            '<?= $escaper->escapeJs(__('Fill in the subdomain and username of the %1 account.')) ?>'
                                .replace('%1', fields.language.toUpperCase())
                        );
                    }
                    if (!fields.password && !$(this).data('has-password')) {
                        throw new Error(
                            '<?= $escaper->escapeJs(__('Enter the password of the %1 account.')) ?>'
                                .replace('%1', fields.language.toUpperCase())
                        );
                    }
                    accounts.push(fields);
                });
                var fallback = $('input[name=smaily-w-fallback]:checked').val();
                var fallbackAccount = null;
                accounts.forEach(function (account) {
                    if (account.language === fallback) {
                        fallbackAccount = account;
                    }
                });
                if (!fallback || !fallbackAccount) {
                    throw new Error('<?= $escaper->escapeJs(__('Pick the default fallback account.')) ?>');
                }
                if (fallback !== mlFallbackSaved && !fallbackAccount.password) {
                    throw new Error(
                        '<?= $escaper->escapeJs(__('Enter the password of the %1 account so it can take over as the default fallback.')) ?>'
                            .replace('%1', fallback.toUpperCase())
                    );
                }
                return {
                    // The fallback account's credentials double as the
                    // default-scope credentials (any unmatched scope uses
                    // them), Woo mode-A parity.
                    subdomain: fallbackAccount.subdomain,
                    username: fallbackAccount.username,
                    password: fallbackAccount.password,
                    multilingual_mode: mode,
                    fallback_language: fallback,
                    accounts: accounts
                };
            }
            var creds = credentials();
            if (!connected && (!creds.subdomain || !creds.username || !creds.password)) {
                throw new Error(
                    '<?= $escaper->escapeJs(__('Fill in the credentials and press Test connection first.')) ?>'
                );
            }
            return {
                subdomain: creds.subdomain,
                username: creds.username,
                password: creds.password,
                multilingual_mode: mode
            };
        },
        subscribers: function () {
            var data = {
                sync_enabled: $('#smaily-w-sync-enabled').length
                    ? $('#smaily-w-sync-enabled').is(':checked')
                    : true,
                sync_mode: $('input[name=smaily-w-mode]:checked').val(),
                sync_fields: $('#smaily-w-fields input:checked').map(function () { return $(this).val(); }).get(),
                checkout_optin_enabled: $('#smaily-w-checkout-optin').is(':checked'),
                suppress_optin_emails: $('#smaily-w-suppress').is(':checked')
            };
            // Settings-only controls (not rendered in the wizard) — omit the
            // keys entirely there so the wizard's save never touches them.
            var $includeGuests = $('#smaily-w-include-guests');
            if ($includeGuests.length) {
                data.include_guests = $includeGuests.is(':checked');
            }
            var $forceOptIn = $('#smaily-w-force-opt-in');
            if ($forceOptIn.length) {
                data.automation_force_opt_in = $forceOptIn.is(':checked');
            }
            return data;
        },
        automations: function () {
            var data = {
                welcome_enabled: $('#smaily-w-welcome-enabled').is(':checked'),
                welcome_workflow: $('#smaily-w-welcome-workflow').val(),
                first_order_enabled: $('#smaily-w-firstorder-enabled').is(':checked'),
                first_order_workflow: $('#smaily-w-firstorder-workflow').val(),
                abandoned_enabled: $('#smaily-w-abandoned-enabled').is(':checked'),
                abandoned_workflow: $('#smaily-w-abandoned-workflow').val(),
                abandoned_cutoff: parseInt($('#smaily-w-cutoff').val(), 10) || 30
            };
            // Abandoned-cart product fields (Settings tab only). Always posted so
            // clearing every box saves an empty selection; absent block (wizard)
            // omits the key and leaves the stored value untouched.
            var $fields = $('#smaily-w-abandoned-fields');
            if ($fields.length) {
                data.abandoned_fields = $fields.find('input:checked').map(function () {
                    return $(this).val();
                }).get();
            }
            var mode = currentMlMode();
            if (isMultilingual && (mode === 'a' || mode === 'b')) {
                // The full desired mapping state: cleared selects post no
                // row, which deletes theirs server-side.
                var mappings = [];
                $('.smaily-ml-workflow').each(function () {
                    var workflowId = $(this).val();
                    if (!workflowId) {
                        return;
                    }
                    var trigger = String($(this).data('trigger'));
                    var language = String($(this).data('language'));
                    mappings.push({
                        trigger_type: trigger,
                        language: language,
                        account_key: mode === 'a' ? language : 'default',
                        workflow_id: parseInt(workflowId, 10),
                        is_default_fallback:
                            $('input[name=smaily-ml-fallback-' + trigger + ']:checked').val() === language
                    });
                });
                data.mappings = mappings;
            }
            return data;
        },
        intelligence: function () {
            var data = {browse_tracking: $('#smaily-w-browse').is(':checked')};
            if ($('#smaily-w-sync-catalog').length) {
                data.sync_catalog = $('#smaily-w-sync-catalog').is(':checked');
                data.sync_customers = $('#smaily-w-sync-customers').is(':checked');
                data.sync_orders = $('#smaily-w-sync-orders').is(':checked');
            }
            return data;
        },
        rss: function () {
            return {rss_enabled: $('#smaily-w-rss-enabled').is(':checked')};
        }
    };

    return {
        boot: boot,
        post: post,
        result: result,
        credentials: credentials,
        saveStep: saveStep,
        loadWorkflows: loadWorkflows,
        initAll: initAll,
        collect: collect,
        isConnected: function () { return connected; }
    };
};
</script>
