 *
 * Shared behavior for the step/tab panels — included by BOTH the setup
 * wizard and the Settings page, so the two surfaces run the same code
 * instead of copies. Defines window.smailyPanelsInit synchronously (no
 * dependencies); the page script passes jQuery in and receives the API:
 *
 *   var panels = window.smailyPanelsInit($);
 *   panels.initAll();               // prefill + wire whatever panels exist
 *   panels.collect.connect();       // per-panel save payloads
 *   panels.saveStep(name, data);    // POST to the shared savestep endpoint
 *
 * Strings are translated server-side: Magento's js-translation.json
 * dictionary is built from .js and .html files only — $t() inside a phtml
 * inline script never gets collected, so it would always render English.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Smaily\Connect\ViewModel\Adminhtml\WizardData $viewModel */
$viewModel = $block->getData('view_model');
$urls = [
    'test' => $block->getUrl('smaily_connect/api/testsmaily'),
    'workflows' => $block->getUrl('smaily_connect/api/workflows'),
    'saveStep' => $block->getUrl('smaily_connect/api/savestep'),
    'engineExchange' => $block->getUrl('smaily_connect/api/engineexchange'),
    'enginePing' => $block->getUrl('smaily_connect/api/engineping'),
    'backfill' => $block->getUrl('smaily_connect/api/backfillstate'),
];
?>
<script>
window.smailyPanelsInit = function ($) {
    'use strict';

    var boot = <?= /* @noEscape */ $viewModel->getBootJson() ?>;
    var urls = <?= /* @noEscape */ json_encode(array_map('strval', $urls)) ?>;
    var connected = boot.connected;

    function post(url, data) {
        return fetch(url + '?form_key=' + encodeURIComponent(window.FORM_KEY), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data || {})
        }).then(function (r) { return r.json(); });
    }

    function result(selector, text, ok) {
        $(selector).text(text).removeClass('ok err').addClass(ok ? 'ok' : 'err');
    }

    function credentials() {
        return {
            subdomain: $('#smaily-w-subdomain').val(),
            username: $('#smaily-w-username').val(),
            password: $('#smaily-w-password').val()
        };
    }

    function saveStep(name, data) {
        return post(urls.saveStep, {step: name, data: data}).then(function (response) {
            if (!response.saved) {
                var message = (response.errors || []).map(function (e) { return e.message; }).join(' ');
                throw new Error(message || '<?= $escaper->escapeJs(__('Saving failed.')) ?>');
            }
        });
    }

    function fillWorkflows(workflows) {
        $('.smaily-w-workflow').each(function () {
            var current = $(this).val() || $(this).data('saved') || '';
            $(this).empty().append(new Option('<?= $escaper->escapeJs(__('-- Not Selected --')) ?>', ''));
            (workflows || []).forEach(function (w) {
                $(this).append(new Option(w.name + ' (' + w.id + ')', w.id));
            }.bind(this));
            $(this).val(current);
        });
    }

    function loadWorkflows(resultSelector) {
        return post(urls.workflows, credentials()).then(function (data) {
            fillWorkflows(data.workflows);
            if (data.error && resultSelector) {
                result(resultSelector, data.error, false);
            }
        });
    }

    // --- Backfill progress polling (contacts + engine imports) -------------
    var backfillTimers = {};

    function pollBackfill(jobType, $bar, resultSelector, startFirst) {
        post(urls.backfill, {job_type: jobType, action: startFirst ? 'start' : 'status'}).then(function (data) {
            if (data.status === 'running') {
                $bar.show().val(data.percent);
                result(resultSelector,
                    '<?= $escaper->escapeJs(__('Importing… %1 / %2')) ?>'
                        .replace('%1', data.processed).replace('%2', data.total || '?'), true);
                backfillTimers[jobType] = setTimeout(function () {
                    pollBackfill(jobType, $bar, resultSelector, false);
                }, 4000);
            } else if (data.status === 'completed') {
                $bar.show().val(100);
                result(resultSelector,
                    '<?= $escaper->escapeJs(__('Import completed (%1 items).')) ?>'
                        .replace('%1', data.processed), true);
            } else if (data.status === 'failed') {
                result(resultSelector,
                    '<?= $escaper->escapeJs(__('Import failed — see the Log for details.')) ?>', false);
            }
        });
    }

    function startBackfill(jobType, $bar, resultSelector) {
        clearTimeout(backfillTimers[jobType]);
        pollBackfill(jobType, $bar, resultSelector, true);
    }

    function engineConnected(tenantName, engineVersion) {
        $('#smaily-w-engine-disconnected').hide();
        $('#smaily-w-engine-connected').show();
        $('#smaily-w-engine-status').text(
            '<?= $escaper->escapeJs(__('Connected: %1 (engine %2)')) ?>'
                .replace('%1', tenantName).replace('%2', engineVersion)
        );
    }

    // --- Live reactivity within panels --------------------------------------
    function reactAutomationRow(checkboxSelector, selectSelector) {
        var apply = function () {
            $(selectSelector).prop('disabled', !$(checkboxSelector).is(':checked'));
        };
        $(document).on('change', checkboxSelector, apply);
        apply();
    }

    function reactSubscribersEnabled() {
        if (!$('#smaily-w-sync-enabled').length) {
            return;
        }
        var apply = function () {
            var on = $('#smaily-w-sync-enabled').is(':checked');
            $('#smaily-w-subscribers-body').toggleClass('smaily-muted', !on)
                .find('input').prop('disabled', !on);
        };
        $(document).on('change', '#smaily-w-sync-enabled', apply);
        apply();
    }

    function reactRssEnabled() {
        if (!$('#smaily-w-rss-enabled').length) {
            return;
        }
        var apply = function () {
            $('#smaily-w-rss-builder-wrap').toggle($('#smaily-w-rss-enabled').is(':checked'));
        };
        $(document).on('change', '#smaily-w-rss-enabled', apply);
        apply();
    }

    // --- Prefill from the saved settings ------------------------------------
    function initAll() {
        // Connection.
        $('#smaily-w-subdomain').val(boot.connection.subdomain);
        $('#smaily-w-username').val(boot.connection.username);
        if (boot.connection.hasPassword) {
            $('#smaily-w-password-note').show();
        }
        if (connected) {
            result('#smaily-w-test-result', '<?= $escaper->escapeJs(__('Connected with the saved credentials.')) ?>', true);
        }

        // Subscribers (sync-field checkboxes are server-rendered).
        $('#smaily-w-sync-enabled').prop('checked', boot.subscribers.syncEnabled);
        $('input[name=smaily-w-mode][value=' + boot.subscribers.syncMode + ']').prop('checked', true);
        $('#smaily-w-checkout-optin').prop('checked', boot.subscribers.checkoutOptin);
        $('#smaily-w-suppress').prop('checked', boot.subscribers.suppressOptinEmails);

        // Automations.
        $('#smaily-w-welcome-enabled').prop('checked', boot.automations.welcomeEnabled);
        $('#smaily-w-firstorder-enabled').prop('checked', boot.automations.firstOrderEnabled);
        $('#smaily-w-abandoned-enabled').prop('checked', boot.automations.abandonedEnabled);
        $('#smaily-w-cutoff').val(boot.automations.abandonedCutoff);
        $('#smaily-w-welcome-workflow').data('saved', boot.automations.welcomeWorkflow);
        $('#smaily-w-firstorder-workflow').data('saved', boot.automations.firstOrderWorkflow);
        $('#smaily-w-abandoned-workflow').data('saved', boot.automations.abandonedWorkflow);

        // Intelligence.
        if (boot.intelligence.connected) {
            engineConnected(boot.intelligence.tenantName, boot.intelligence.engineVersion);
            $('#smaily-w-browse').prop('checked', boot.intelligence.browseTracking);
            $('#smaily-w-sync-catalog').prop('checked', boot.intelligence.syncCatalog);
            $('#smaily-w-sync-customers').prop('checked', boot.intelligence.syncCustomers);
            $('#smaily-w-sync-orders').prop('checked', boot.intelligence.syncOrders);
        }

        // RSS (Settings only).
        $('#smaily-w-rss-enabled').prop('checked', boot.rss.enabled);

        // Radio-card highlight.
        $(document).on('change', 'input[name=smaily-w-mode]', function () {
            $('.smaily-choice').removeClass('selected');
            $(this).closest('.smaily-choice').addClass('selected');
        });
        $('input[name=smaily-w-mode]:checked').trigger('change');

        // Live reactivity: dependent fields follow their controlling toggle.
        reactAutomationRow('#smaily-w-welcome-enabled', '#smaily-w-welcome-workflow');
        reactAutomationRow('#smaily-w-firstorder-enabled', '#smaily-w-firstorder-workflow');
        reactAutomationRow('#smaily-w-abandoned-enabled', '#smaily-w-abandoned-workflow, #smaily-w-cutoff');
        reactSubscribersEnabled();
        reactRssEnabled();

        // Connection test.
        $('#smaily-w-test').on('click', function () {
            result('#smaily-w-test-result', '<?= $escaper->escapeJs(__('Testing…')) ?>', true);
            post(urls.test, credentials()).then(function (data) {
                connected = !!data.connected;
                result('#smaily-w-test-result', data.connected
                    ? '<?= $escaper->escapeJs(__('Connected! Continue to the next step.')) ?>'
                    : (data.error || '<?= $escaper->escapeJs(__('Connection failed.')) ?>'), data.connected);
                if (data.connected) {
                    // Changed credentials re-render the dependent workflow
                    // dropdowns without saving anything.
                    loadWorkflows(null);
                }
            });
        });

        // Contacts import.
        $('#smaily-w-backfill').on('click', function () {
            startBackfill('contacts', $('#smaily-w-backfill-bar'), '#smaily-w-backfill-result');
        });

        // Engine imports (Settings only).
        $('.smaily-import-row .smaily-w-engine-import').on('click', function () {
            var $row = $(this).closest('.smaily-import-row');
            startBackfill($row.data('job-type'), $row.find('progress'), $row.find('.smaily-result'));
        });

        // Workflow refresh.
        $('#smaily-w-refresh-workflows').on('click', function () {
            loadWorkflows(null);
        });

        // Engine connect.
        $('#smaily-w-engine-connect').on('click', function () {
            result('#smaily-w-engine-result', '<?= $escaper->escapeJs(__('Connecting…')) ?>', true);
            post(urls.engineExchange, {setup_url: $('#smaily-w-setup-url').val()}).then(function (data) {
                if (data.connected) {
                    engineConnected(data.tenantName, data.engineVersion);
                } else {
                    result('#smaily-w-engine-result',
                        data.message || '<?= $escaper->escapeJs(__('Connection failed.')) ?>', false);
                }
            });
        });
    }

    // --- Per-panel save payloads (shared savestep endpoint) -----------------
    var collect = {
        connect: function () {
            var creds = credentials();
            if (!connected && (!creds.subdomain || !creds.username || !creds.password)) {
                throw new Error(
                    '<?= $escaper->escapeJs(__('Fill in the credentials and press Test Connection first.')) ?>'
                );
            }
            return {
                subdomain: creds.subdomain,
                username: creds.username,
                password: creds.password,
                multilingual_mode: boot.connection.multilingualMode
            };
        },
        subscribers: function () {
            return {
                sync_enabled: $('#smaily-w-sync-enabled').length
                    ? $('#smaily-w-sync-enabled').is(':checked')
                    : true,
                sync_mode: $('input[name=smaily-w-mode]:checked').val(),
                sync_fields: $('#smaily-w-fields input:checked').map(function () { return $(this).val(); }).get(),
                checkout_optin_enabled: $('#smaily-w-checkout-optin').is(':checked'),
                suppress_optin_emails: $('#smaily-w-suppress').is(':checked')
            };
        },
        automations: function () {
            return {
                welcome_enabled: $('#smaily-w-welcome-enabled').is(':checked'),
                welcome_workflow: $('#smaily-w-welcome-workflow').val(),
                first_order_enabled: $('#smaily-w-firstorder-enabled').is(':checked'),
                first_order_workflow: $('#smaily-w-firstorder-workflow').val(),
                abandoned_enabled: $('#smaily-w-abandoned-enabled').is(':checked'),
                abandoned_workflow: $('#smaily-w-abandoned-workflow').val(),
                abandoned_cutoff: parseInt($('#smaily-w-cutoff').val(), 10) || 30
            };
        },
        intelligence: function () {
            var data = {browse_tracking: $('#smaily-w-browse').is(':checked')};
            if ($('#smaily-w-sync-catalog').length) {
                data.sync_catalog = $('#smaily-w-sync-catalog').is(':checked');
                data.sync_customers = $('#smaily-w-sync-customers').is(':checked');
                data.sync_orders = $('#smaily-w-sync-orders').is(':checked');
            }
            return data;
        },
        rss: function () {
            return {rss_enabled: $('#smaily-w-rss-enabled').is(':checked')};
        }
    };

    return {
        boot: boot,
        post: post,
        result: result,
        credentials: credentials,
        saveStep: saveStep,
        loadWorkflows: loadWorkflows,
        initAll: initAll,
        collect: collect,
        isConnected: function () { return connected; }
    };
};
</script>
