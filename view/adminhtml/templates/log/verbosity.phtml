 *
 * Log verbosity control (error/info/debug) — this field is installation-wide
 * (default scope only, no website/store meaning) and has no design-pack
 * mockup of its own; placed as a small settings strip above the grid per
 * docs/ADMIN_UI_TARGET_SPEC.md §2.4(a)/§4.2.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Smaily\Connect\ViewModel\Adminhtml\LogVerbositySettings $viewModel */
$viewModel = $block->getData('view_model');
$current = $viewModel->getVerbosity();
$saveUrl = $block->getUrl('smaily_connect/api/saveverbosity');
?>
<div class="smaily-ui smaily-log-verbosity">
    <label for="smaily-log-verbosity-select"><?= $escaper->escapeHtml(__('Log Verbosity')) ?></label>
    <select id="smaily-log-verbosity-select">
        <?php foreach ($viewModel->getOptions() as $option): ?>
        <option value="<?= $escaper->escapeHtmlAttr((string)$option['value']) ?>"
                <?= (string)$option['value'] === $current ? 'selected="selected"' : '' ?>>
            <?= $escaper->escapeHtml((string)$option['label']) ?>
        </option>
        <?php endforeach; ?>
    </select>
    <button type="button" class="action-secondary" id="smaily-log-verbosity-save">
        <span><?= $escaper->escapeHtml(__('Save')) ?></span>
    </button>
    <span class="smaily-result" id="smaily-log-verbosity-result"></span>
    <p class="note"><?= $escaper->escapeHtml(__('Logs are written to var/log/smaily_connect.log. Debug verbosity logs full API requests and responses; use only for troubleshooting.')) ?></p>
</div>
<script>
require(['jquery'], function ($) {
    'use strict';

    function post(url, data) {
        var separator = url.indexOf('?') === -1 ? '?' : '&';

        return fetch(url + separator + 'form_key=' + encodeURIComponent(window.FORM_KEY), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data)
        }).then(function (response) { return response.json(); });
    }

    function setResult(text, ok) {
        $('#smaily-log-verbosity-result').text(text).css('color', ok ? '#006400' : '#e22626');
    }

    $('#smaily-log-verbosity-save').on('click', function () {
        var $button = $(this);
        $button.prop('disabled', true);
        setResult('<?= $escaper->escapeJs(__('Saving…')) ?>', true);

        post('<?= $escaper->escapeJs($saveUrl) ?>', {verbosity: $('#smaily-log-verbosity-select').val()})
            .then(function (data) {
                if (data.saved) {
                    setResult('<?= $escaper->escapeJs(__('Saved.')) ?>', true);
                } else {
                    setResult(data.error || '<?= $escaper->escapeJs(__('Saving failed.')) ?>', false);
                }
            })
            .catch(function () {
                setResult('<?= $escaper->escapeJs(__('Saving failed.')) ?>', false);
            })
            .finally(function () {
                $button.prop('disabled', false);
            });
    });
});
</script>
