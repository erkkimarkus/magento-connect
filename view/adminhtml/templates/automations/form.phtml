/** @var \Smaily\Connect\ViewModel\Adminhtml\AutomationsForm $viewModel */
$viewModel = $block->getData('view_model');
?>
<div class="smaily-automations">
<?php if (!$viewModel->isEngineConnected()): ?>
    <div class="message message-notice">
        <?= $escaper->escapeHtml(__('Connect Campaign Intelligence in Configuration to manage engine-run automations.')) ?>
    </div>
<?php elseif ($viewModel->getLoadError() !== null): ?>
    <div class="message message-error">
        <?= $escaper->escapeHtml(__('Could not load the automation catalog: %1', $viewModel->getLoadError())) ?>
    </div>
<?php else: ?>
    <?php $workflows = $viewModel->getWorkflows(); ?>
    <p><?= $escaper->escapeHtml(__('These automations run inside the Campaign Intelligence engine (e.g. replenishment reminders, win-back). Each trigger fires the mapped Smaily workflow. Triggers start disabled and in test mode — fail closed by design.')) ?></p>
    <form action="<?= $escaper->escapeUrl($block->getUrl('smaily_connect/automations/save')) ?>" method="post">
        <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
        <div class="admin__table-wrapper">
            <table class="admin__table-secondary">
                <thead>
                    <tr>
                        <th><?= $escaper->escapeHtml(__('Enabled')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Trigger')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Smaily Workflow')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Cooldown (days)')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Daily Cap')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Test Mode')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Test Emails')) ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($viewModel->getRows() as $row): ?>
                    <?php $name = 'triggers[' . $escaper->escapeHtmlAttr($row['key']) . ']'; ?>
                    <tr>
                        <td>
                            <input type="checkbox" name="<?= /* @noEscape */ $name ?>[enabled]" value="1"
                                <?= $row['enabled'] ? 'checked' : '' ?>/>
                        </td>
                        <td>
                            <strong><?= $escaper->escapeHtml($row['name']) ?></strong><br/>
                            <small><?= $escaper->escapeHtml($row['description']) ?></small>
                        </td>
                        <td>
                            <select name="<?= /* @noEscape */ $name ?>[workflow_id]">
                                <option value=""><?= $escaper->escapeHtml(__('-- Not Selected --')) ?></option>
                                <?php foreach ($workflows as $workflow): ?>
                                    <option value="<?= (int)$workflow['id'] ?>"
                                        <?= (string)$workflow['id'] === $row['workflow_id'] ? 'selected' : '' ?>>
                                        <?= $escaper->escapeHtml($workflow['title']) ?>
                                    </option>
                                <?php endforeach; ?>
                            </select>
                        </td>
                        <td>
                            <input type="number" min="1" max="365" style="width: 6rem;"
                                   name="<?= /* @noEscape */ $name ?>[cooldown_days]"
                                   value="<?= (int)$row['cooldown_days'] ?>"/>
                        </td>
                        <td>
                            <input type="number" min="1" max="100000" style="width: 7rem;"
                                   name="<?= /* @noEscape */ $name ?>[daily_cap]"
                                   value="<?= $row['daily_cap'] === null ? '' : (int)$row['daily_cap'] ?>"
                                   placeholder="<?= $escaper->escapeHtmlAttr(__('No cap')) ?>"/>
                        </td>
                        <td>
                            <input type="checkbox" name="<?= /* @noEscape */ $name ?>[test_mode]" value="1"
                                <?= $row['test_mode'] ? 'checked' : '' ?>/>
                        </td>
                        <td>
                            <input type="text" style="width: 16rem;"
                                   name="<?= /* @noEscape */ $name ?>[test_emails]"
                                   value="<?= $escaper->escapeHtmlAttr($row['test_emails']) ?>"
                                   placeholder="a@example.com, b@example.com"/>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        <div class="actions-toolbar" style="margin-top: 2rem;">
            <button type="submit" class="action-primary">
                <span><?= $escaper->escapeHtml(__('Save Automations')) ?></span>
            </button>
        </div>
    </form>
<?php endif; ?>
</div>
