 *
 * Config-page assistant for the Smaily Connect section:
 * - Test Connection button (tests the credentials as typed, no save needed)
 * - AJAX workflow dropdowns (fill from the live Smaily account without an
 *   intermediate save; refresh when credentials change)
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

if ($block->getRequest()->getParam('section') !== 'smaily_connect') {
    return;
}
$testUrl = $block->getUrl('smaily_connect/api/testsmaily');
$workflowsUrl = $block->getUrl('smaily_connect/api/workflows');
$storeParam = (int)$block->getRequest()->getParam('store');
?>
<script>
require(['jquery', 'mage/translate'], function ($, $t) {
    'use strict';

    var FIELDS = {
        subdomain: '#smaily_connect_connection_subdomain',
        username: '#smaily_connect_connection_username',
        password: '#smaily_connect_connection_password'
    };
    var WORKFLOW_SELECTS = [
        '#smaily_connect_automations_welcome_workflow',
        '#smaily_connect_automations_first_order_workflow',
        '#smaily_connect_automations_abandoned_workflow'
    ];

    function credentials() {
        return {
            subdomain: $(FIELDS.subdomain).val() || '',
            username: $(FIELDS.username).val() || '',
            password: $(FIELDS.password).val() || '',
            store_id: <?= /* @noEscape */ (string)$storeParam ?>,
            form_key: window.FORM_KEY
        };
    }

    function post(url, data) {
        return fetch(url + '?form_key=' + encodeURIComponent(window.FORM_KEY), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data)
        }).then(function (response) { return response.json(); });
    }

    function setResult(text, ok) {
        $('#smaily-test-connection-result')
            .text(text)
            .css('color', ok ? '#006400' : '#e22626');
    }

    /**
     * Fill the automation workflow selects from the live account, keeping
     * the currently selected value. Obscured (unchanged) passwords fall back
     * to the saved credentials server-side.
     */
    function refreshWorkflows() {
        var current = {};
        WORKFLOW_SELECTS.forEach(function (selector) {
            var $select = $(selector);
            if ($select.length) {
                current[selector] = $select.val();
            }
        });
        if (!Object.keys(current).length) {
            return;
        }

        post('<?= $escaper->escapeJs($workflowsUrl) ?>', credentials()).then(function (data) {
            if (!data.workflows || !data.workflows.length) {
                return;
            }
            WORKFLOW_SELECTS.forEach(function (selector) {
                var $select = $(selector);
                if (!$select.length) {
                    return;
                }
                var selected = current[selector];
                $select.empty().append(new Option($t('-- Not Selected --'), ''));
                data.workflows.forEach(function (workflow) {
                    $select.append(new Option(workflow.name + ' (' + workflow.id + ')', workflow.id));
                });
                if (selected) {
                    $select.val(selected);
                }
            });
        }).catch(function () { /* dropdowns keep their server-rendered options */ });
    }

    $(function () {
        $('#smaily-test-connection').on('click', function () {
            var creds = credentials();
            if (!creds.subdomain || !creds.username) {
                setResult($t('Fill in the subdomain and username first.'), false);
                return;
            }
            setResult($t('Testing…'), true);
            post('<?= $escaper->escapeJs($testUrl) ?>', creds).then(function (data) {
                if (data.connected) {
                    setResult($t('Connected! The workflow dropdowns below are now up to date.'), true);
                    refreshWorkflows();
                } else {
                    setResult(data.error || $t('Connection failed.'), false);
                }
            }).catch(function () {
                setResult($t('Connection failed.'), false);
            });
        });

        // Fill the dropdowns on load from saved credentials, and again when
        // the merchant edits the connection fields (debounced).
        refreshWorkflows();
        var timer = null;
        $(Object.values(FIELDS).join(',')).on('input', function () {
            clearTimeout(timer);
            timer = setTimeout(refreshWorkflows, 1200);
        });
    });
});
</script>
