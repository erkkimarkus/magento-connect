            <a href="<?= $escaper->escapeUrl($configUrl) ?>"><?= $escaper->escapeHtml(__('Stores > Configuration > Smaily > Smaily Connect')) ?></a>.
        </p>
        <div>
            <span class="smaily-result" id="smaily-s-save-result"></span>
