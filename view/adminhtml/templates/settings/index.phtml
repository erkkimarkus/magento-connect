    'subscribers' => __('Subscribers'),
    'automations' => __('Automations'),
    'intelligence' => __('Intelligence'),
    'rss' => __('RSS'),
];
$configUrl = $block->getUrl('adminhtml/system_config/edit', ['section' => 'smaily_connect']);

/** @var \Smaily\Connect\ViewModel\Adminhtml\ConfigOverrides $overridesViewModel */
$overridesViewModel = $block->getData('config_overrides');
$clearOverrideUrl = $block->getUrl('smaily_connect/config/clearoverride');
?>
<div id="smaily-settings" class="smaily-ui smaily-settings">
    <ul class="smaily-tabs">
        <?php foreach ($tabs as $tabId => $tabLabel): ?>
        <li data-tab="<?= $escaper->escapeHtmlAttr($tabId) ?>"><?= $escaper->escapeHtml($tabLabel) ?></li>
