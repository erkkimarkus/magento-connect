    <div class="smaily-tab-panel" data-tab="connection">
        <h3><?= $escaper->escapeHtml(__('Connection')) ?></h3>
        <p class="smaily-tab-desc"><?= $escaper->escapeHtml(__('Your Smaily API credentials for this store.')) ?></p>
        <?= $block->getChildHtml('panel.connection') ?>
    </div>
    <div class="smaily-tab-panel" data-tab="subscribers"><?= $block->getChildHtml('panel.subscribers') ?></div>
    <div class="smaily-tab-panel" data-tab="automations">
        <?= $block->getChildHtml('panel.automations') ?>
        <div class="smaily-card">
            <?= $block->getChildHtml('engine.automations') ?>
