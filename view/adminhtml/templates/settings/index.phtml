    'subscribers' => __('Subscribers'),
    'automations' => __('Automations'),
    'intelligence' => __('Intelligence'),
    'rss' => __('RSS'),
];
$configUrl = $block->getUrl('adminhtml/system_config/edit', ['section' => 'smaily_connect']);
?>
