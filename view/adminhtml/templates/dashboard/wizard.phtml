<script>
require(['jquery'], function ($) {
    'use strict';

    var boot = <?= /* @noEscape */ $viewModel->getBootJson() ?>;
    var urls = <?= /* @noEscape */ json_encode(array_map('strval', $urls)) ?>;
    // Strings are translated server-side: Magento's js-translation.json
    // dictionary is built from .js and .html files only — $t() inside a
    // phtml inline script never gets collected, so it would always render
    // English.
    //
    // step = the step currently shown; maxStep = the furthest step ever
    // reached (from the saved config on load, then per-step saves). The
    // stepper derives "done" (unlocked, clickable) from maxStep, so going
    // Back never re-locks steps that were already completed.
    var step = 1, maxStep = 1, connected = boot.connected;

    function post(url, data) {
        return fetch(url + '?form_key=' + encodeURIComponent(window.FORM_KEY), {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data || {})
        }).then(function (r) { return r.json(); });
    }

    function result(selector, text, ok) {
        $(selector).text(text).removeClass('ok err').addClass(ok ? 'ok' : 'err');
    }

    function credentials() {
        return {
            subdomain: $('#smaily-w-subdomain').val(),
            username: $('#smaily-w-username').val(),
            password: $('#smaily-w-password').val()
        };
    }

    function render() {
        $('.smaily-steps li').each(function () {
            var s = $(this).data('step');
            $(this).toggleClass('active', s === step).toggleClass('done', s !== step && s <= maxStep);
        });
        $('.smaily-step-panel').removeClass('active');
        $('.smaily-step-panel[data-step=' + step + ']').addClass('active');
        $('#smaily-w-back').toggle(step > 1 && step < 5);
        $('#smaily-w-next').toggle(step < 5);
        $('#smaily-w-next span').text(step === 4
            ? '<?= $escaper->escapeJs(__('Finish')) ?>'
            : '<?= $escaper->escapeJs(__('Continue')) ?>');
        $('#smaily-w-save-result').text('');
        window.scrollTo(0, 0);
    }

    function fillWorkflows(workflows) {
        $('.smaily-w-workflow').each(function () {
            var current = $(this).val() || $(this).data('saved') || '';
            $(this).empty().append(new Option('<?= $escaper->escapeJs(__('-- Not Selected --')) ?>', ''));
            (workflows || []).forEach(function (w) {
                $(this).append(new Option(w.name + ' (' + w.id + ')', w.id));
            }.bind(this));
            $(this).val(current);
        });
    }

    function loadWorkflows() {
        return post(urls.workflows, credentials()).then(function (data) {
            fillWorkflows(data.workflows);
            if (data.error) {
                result('#smaily-w-save-result', data.error, false);
            }
        });
    }

    function saveStep(name, data) {
        return post(urls.saveStep, {step: name, data: data}).then(function (response) {
            if (!response.saved) {
                var message = (response.errors || []).map(function (e) { return e.message; }).join(' ');
                throw new Error(message || '<?= $escaper->escapeJs(__('Saving failed.')) ?>');
            }
        });
    }

    var stepSavers = {
        1: function () {
            var creds = credentials();
            if (!connected && (!creds.subdomain || !creds.username || !creds.password)) {
                return Promise.reject(new Error(
                    '<?= $escaper->escapeJs(__('Fill in the credentials and press Test Connection first.')) ?>'
                ));
            }
            return saveStep('connect', {
                subdomain: creds.subdomain,
                username: creds.username,
                password: creds.password,
                multilingual_mode: boot.connection.multilingualMode
            });
        },
        2: function () {
            return saveStep('subscribers', {
                sync_enabled: true,
                sync_mode: $('input[name=smaily-w-mode]:checked').val(),
                sync_fields: $('#smaily-w-fields input:checked').map(function () { return $(this).val(); }).get(),
                checkout_optin_enabled: $('#smaily-w-checkout-optin').is(':checked'),
                suppress_optin_emails: $('#smaily-w-suppress').is(':checked')
            });
        },
        3: function () {
            return saveStep('automations', {
                welcome_enabled: $('#smaily-w-welcome-enabled').is(':checked'),
                welcome_workflow: $('#smaily-w-welcome-workflow').val(),
                first_order_enabled: $('#smaily-w-firstorder-enabled').is(':checked'),
                first_order_workflow: $('#smaily-w-firstorder-workflow').val(),
                abandoned_enabled: $('#smaily-w-abandoned-enabled').is(':checked'),
                abandoned_workflow: $('#smaily-w-abandoned-workflow').val(),
                abandoned_cutoff: parseInt($('#smaily-w-cutoff').val(), 10) || 30
            });
        },
        4: function () {
            return saveStep('intelligence', {
                browse_tracking: $('#smaily-w-browse').is(':checked')
            }).then(function () {
                return saveStep('finish', {});
            });
        }
    };

    // --- Prefill from saved settings -------------------------------------
    $('#smaily-w-subdomain').val(boot.connection.subdomain);
    $('#smaily-w-username').val(boot.connection.username);
    if (boot.connection.hasPassword) {
        $('#smaily-w-password-note').show();
    }
    if (connected) {
        result('#smaily-w-test-result', '<?= $escaper->escapeJs(__('Connected with the saved credentials.')) ?>', true);
    }

    // Step-2 sync-field checkboxes are server-rendered (see #smaily-w-fields
    // in the markup above) — no client-side HTML building.
    $('input[name=smaily-w-mode][value=' + boot.subscribers.syncMode + ']').prop('checked', true);
    $('#smaily-w-checkout-optin').prop('checked', boot.subscribers.checkoutOptin);
    $('#smaily-w-suppress').prop('checked', boot.subscribers.suppressOptinEmails);

    $('#smaily-w-welcome-enabled').prop('checked', boot.automations.welcomeEnabled);
    $('#smaily-w-firstorder-enabled').prop('checked', boot.automations.firstOrderEnabled);
    $('#smaily-w-abandoned-enabled').prop('checked', boot.automations.abandonedEnabled);
    $('#smaily-w-cutoff').val(boot.automations.abandonedCutoff);
    $('#smaily-w-welcome-workflow').data('saved', boot.automations.welcomeWorkflow);
    $('#smaily-w-firstorder-workflow').data('saved', boot.automations.firstOrderWorkflow);
    $('#smaily-w-abandoned-workflow').data('saved', boot.automations.abandonedWorkflow);

    if (boot.intelligence.connected) {
        $('#smaily-w-engine-disconnected').hide();
        $('#smaily-w-engine-connected').show();
        $('#smaily-w-engine-status').text(
            '<?= $escaper->escapeJs(__('Connected: %1 (engine %2)')) ?>'
                .replace('%1', boot.intelligence.tenantName).replace('%2', boot.intelligence.engineVersion)
        );
        $('#smaily-w-browse').prop('checked', boot.intelligence.browseTracking);
    }

    // Radio-card highlight.
    $(document).on('change', 'input[name=smaily-w-mode]', function () {
        $('.smaily-choice').removeClass('selected');
        $(this).closest('.smaily-choice').addClass('selected');
    });
    $('input[name=smaily-w-mode]:checked').trigger('change');

    // --- Step 1 actions ---------------------------------------------------
    $('#smaily-w-test').on('click', function () {
        result('#smaily-w-test-result', '<?= $escaper->escapeJs(__('Testing…')) ?>', true);
        post(urls.test, credentials()).then(function (data) {
            connected = !!data.connected;
            result('#smaily-w-test-result', data.connected
                ? '<?= $escaper->escapeJs(__('Connected! Continue to the next step.')) ?>'
                : (data.error || '<?= $escaper->escapeJs(__('Connection failed.')) ?>'), data.connected);
        });
    });

    // --- Step 2 backfill ----------------------------------------------------
    var backfillTimer = null;
    function pollBackfill(startFirst) {
        post(urls.backfill, {job_type: 'contacts', action: startFirst ? 'start' : 'status'}).then(function (data) {
            var $bar = $('#smaily-w-backfill-bar');
            if (data.status === 'running') {
                $bar.show().val(data.percent);
                result('#smaily-w-backfill-result',
                    '<?= $escaper->escapeJs(__('Importing… %1 / %2')) ?>'
                        .replace('%1', data.processed).replace('%2', data.total || '?'), true);
                backfillTimer = setTimeout(function () { pollBackfill(false); }, 4000);
            } else if (data.status === 'completed') {
                $bar.show().val(100);
                result('#smaily-w-backfill-result',
                    '<?= $escaper->escapeJs(__('Import completed (%1 contacts).')) ?>'
                        .replace('%1', data.processed), true);
            } else if (data.status === 'failed') {
                result('#smaily-w-backfill-result',
                    '<?= $escaper->escapeJs(__('Import failed — see the Event Log for details.')) ?>', false);
            }
        });
    }
    $('#smaily-w-backfill').on('click', function () {
        clearTimeout(backfillTimer);
        pollBackfill(true);
    });

    // --- Step 3 workflows ---------------------------------------------------
    $('#smaily-w-refresh-workflows').on('click', loadWorkflows);

    // --- Step 4 engine --------------------------------------------------------
    $('#smaily-w-engine-connect').on('click', function () {
        result('#smaily-w-engine-result', '<?= $escaper->escapeJs(__('Connecting…')) ?>', true);
        post(urls.engineExchange, {setup_url: $('#smaily-w-setup-url').val()}).then(function (data) {
            if (data.connected) {
                $('#smaily-w-engine-disconnected').hide();
                $('#smaily-w-engine-connected').show();
                $('#smaily-w-engine-status').text(
                    '<?= $escaper->escapeJs(__('Connected: %1 (engine %2)')) ?>'
                        .replace('%1', data.tenantName).replace('%2', data.engineVersion)
                );
            } else {
                result('#smaily-w-engine-result',
                    data.message || '<?= $escaper->escapeJs(__('Connection failed.')) ?>', false);
            }
        });
    });

    // --- Navigation -----------------------------------------------------------
    $('#smaily-w-next').on('click', function () {
        var $button = $(this).prop('disabled', true);
        result('#smaily-w-save-result', '<?= $escaper->escapeJs(__('Saving…')) ?>', true);
        stepSavers[step]().then(function () {
            result('#smaily-w-save-result', '', true);
            if (step === 3) {
                step = 4;
            } else if (step === 4) {
                step = 5;
            } else {
                step += 1;
            }
            maxStep = Math.max(maxStep, step);
            if (step === 3) {
                loadWorkflows();
            }
            render();
        }).catch(function (error) {
            result('#smaily-w-save-result', error.message, false);
        }).finally(function () {
            $button.prop('disabled', false);
        });
    });
    $('#smaily-w-back').on('click', function () {
        step = Math.max(1, step - 1);
        render();
    });
    $('.smaily-steps').on('click', 'li.done', function () {
        step = $(this).data('step');
        if (step === 3) {
            loadWorkflows();
        }
        render();
    });

    if (boot.setupCompleted) {
        // Setup finished earlier: every step was completed, keep them all
        // unlocked for revisits.
        step = 5;
    } else if (connected) {
        step = 2;
    }
    maxStep = step;
    if (step === 3) {
        loadWorkflows();
    }
    render();
});
</script>
