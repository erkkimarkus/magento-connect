                    <span class="note"><?= $escaper->escapeHtml(__('Need a category-filtered or sorted feed? Use the URL builder under Configuration > Product RSS Feed.')) ?>
                        <a href="<?= $escaper->escapeUrl($urls['config'] . '#smaily_connect_rss-link') ?>"><?= $escaper->escapeHtml(__('Open the URL builder')) ?></a></span></li>
                <li><a href="<?= $escaper->escapeUrl($userGuideUrl) ?>" target="_blank" rel="noopener noreferrer"><?= $escaper->escapeHtml(__('User Guide')) ?></a> — <?= $escaper->escapeHtml(__('the full merchant documentation: every feature, setting and troubleshooting steps')) ?></li>
