/** @var \Smaily\Connect\ViewModel\Adminhtml\BackfillActions $viewModel */
$viewModel = $block->getData('view_model');
$types = $viewModel->getAvailableTypes();
?>
<div class="smaily-backfill-actions" style="margin-bottom: 2rem;">
    <?php if (!$types): ?>
        <div class="message message-notice">
            <?= $escaper->escapeHtml(__('Connect Smaily (and optionally Campaign Intelligence) in Configuration to start historical imports.')) ?>
        </div>
    <?php else: ?>
        <?php foreach ($types as $type => $label): ?>
            <form action="<?= $escaper->escapeUrl($block->getUrl('smaily_connect/backfill/start')) ?>"
                  method="post" style="display: inline-block; margin-right: 1rem;">
                <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
                <input type="hidden" name="type" value="<?= $escaper->escapeHtmlAttr($type) ?>"/>
                <button type="submit" class="action-secondary">
                    <span><?= $escaper->escapeHtml($label) ?></span>
                </button>
            </form>
        <?php endforeach; ?>
    <?php endif; ?>
</div>
