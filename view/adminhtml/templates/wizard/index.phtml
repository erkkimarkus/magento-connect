<?= $block->getChildHtml('panel.js') ?>
<script>
require(['jquery'], function ($) {
    'use strict';

    var panels = window.smailyPanelsInit($);
    // Strings are translated server-side — see panel/panels-js.phtml.
    //
    // step = the step currently shown; maxStep = the furthest step ever
    // reached (from the saved config on load, then per-step saves). The
    // stepper derives "done" (unlocked, clickable) from maxStep, so going
    // Back never re-locks steps that were already completed.
    var step = 1, maxStep = 1;

    function render() {
        $('.smaily-steps li').each(function () {
            var s = $(this).data('step');
            $(this).toggleClass('active', s === step).toggleClass('done', s !== step && s <= maxStep);
        });
        $('.smaily-step-panel').removeClass('active');
        $('.smaily-step-panel[data-step=' + step + ']').addClass('active');
        $('#smaily-w-back').toggle(step > 1 && step < 5);
        $('#smaily-w-next').toggle(step < 5);
        $('#smaily-w-next span').text(step === 4
            ? '<?= $escaper->escapeJs(__('Finish')) ?>'
            : '<?= $escaper->escapeJs(__('Continue')) ?>');
        $('#smaily-w-save-result').text('');
        window.scrollTo(0, 0);
    }

    /** Wraps a (possibly throwing) collector into a promise chain. */
    function save(name, collector) {
        return new Promise(function (resolve) { resolve(collector()); })
            .then(function (data) { return panels.saveStep(name, data); });
    }

    var stepSavers = {
        1: function () { return save('connect', panels.collect.connect); },
        2: function () { return save('subscribers', panels.collect.subscribers); },
        3: function () { return save('automations', panels.collect.automations); },
        4: function () {
            return save('intelligence', panels.collect.intelligence).then(function () {
                return panels.saveStep('finish', {});
            });
        }
    };

    panels.initAll();

    $('#smaily-w-next').on('click', function () {
        var $button = $(this).prop('disabled', true);
        panels.result('#smaily-w-save-result', '<?= $escaper->escapeJs(__('Saving…')) ?>', true);
        stepSavers[step]().then(function () {
            panels.result('#smaily-w-save-result', '', true);
            step += 1;
            maxStep = Math.max(maxStep, step);
            if (step === 3) {
                panels.loadWorkflows('#smaily-w-save-result');
            }
            render();
        }).catch(function (error) {
            panels.result('#smaily-w-save-result', error.message, false);
        }).finally(function () {
            $button.prop('disabled', false);
        });
    });
    $('#smaily-w-back').on('click', function () {
        step = Math.max(1, step - 1);
        render();
    });
    $('.smaily-steps').on('click', 'li.done', function () {
        step = $(this).data('step');
        if (step === 3) {
            panels.loadWorkflows('#smaily-w-save-result');
        }
        render();
    });

    if (panels.boot.setupCompleted) {
        // Setup finished earlier: every step was completed, keep them all
        // unlocked for revisits.
        step = 5;
    } else if (panels.isConnected()) {
        step = 2;
    }
    maxStep = step;
    if (step === 3) {
        panels.loadWorkflows('#smaily-w-save-result');
    }
    render();
});
</script>
