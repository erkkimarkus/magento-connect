<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <!-- cacheable="false": the form renders the customer's own
                 preference. On a cacheable page Magento depersonalizes the
                 customer session during rendering (so FPC content stays
                 generic), which made the checkbox always show the default —
                 and the cached copy would be shared across customers. Same
                 pattern as every core My Account page. -->
            <block class="Magento\Framework\View\Element\Template"
                   name="smaily.privacy.form"
                   template="Smaily_Connect::privacy/form.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\PrivacyForm</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
