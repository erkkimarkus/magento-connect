 *
 * Hyvä variant of the browse-tracker bootstrap. Same pattern as the
 * attribution template: inert JSON config + a static same-origin JS file,
 * no inline executable script (strict-CSP-safe). The tracker script is
 * emitted after the attribution script in the document (layout order in
 * the base module's default.xml), and `defer` scripts execute in document
 * order, so window.smailyAttribution is available when the tracker runs.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Smaily\Connect\ViewModel\EngineState $viewModel */
$viewModel = $block->getData('view_model');
if (!$viewModel->isBrowseTrackingActive()) {
    return;
}
?>
<script type="application/json" id="smaily-tracker-config">
    <?= /* @noEscape */ $viewModel->getTrackerConfigJson() ?>
</script>
<script defer
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('Hyva_SmailyConnect::js/smaily-tracker.js')) ?>">
</script>
