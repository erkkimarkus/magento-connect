        <div class="flex items-center gap-2">
            <input type="checkbox"
                   id="smaily-profiling-allowed"
                   name="profiling_allowed"
                   value="1"
                   class="form-checkbox"
                   <?= $allowed ? 'checked' : '' ?>/>
            <label class="cursor-pointer select-none" for="smaily-profiling-allowed">
                <span><?= $escaper->escapeHtml(__('Allow personalized recommendations')) ?></span>
            </label>
        </div>
    </fieldset>
    <div>
        <button type="submit" class="btn btn-primary">
            <span><?= $escaper->escapeHtml(__('Save Preference')) ?></span>
        </button>
    </div>
</form>
