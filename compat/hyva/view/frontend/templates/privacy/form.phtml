<form action="<?= $escaper->escapeUrl($block->getUrl('smaily/privacy/save')) ?>" method="post" class="w-full">
    <?= $block->getBlockHtml('formkey') ?>
    <fieldset class="card p-6 mb-6">
        <legend class="text-xl font-medium mb-4">
            <span><?= $escaper->escapeHtml(__('Personalized Recommendations')) ?></span>
        </legend>
        <p class="mb-4 text-gray-700">
            <?= $escaper->escapeHtml(__('We use your shopping activity to personalize product recommendations in our newsletters. You can opt out at any time; newsletters will then show generic content.')) ?>
